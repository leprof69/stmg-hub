{
  "name": "stmg-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx vite",
    "build": "npm run check:encoding && npm run validate:qcm && npx vite build",
    "preview": "npx vite preview",
    "typecheck": "npm run check:encoding && tsc --noEmit -p tsconfig.app.json",
    "check:encoding": "node scripts/check-encoding.mjs",
    "fix:encoding": "node scripts/fix-all-fffd.mjs && node scripts/fix-correctionIA-encoding.mjs",
    "generate:duel-qcm": "node scripts/generate-duel-qcm-bank.mjs",
    "generate:sdgn-qcm": "python scripts/generate_sdgn_mission_qcm.py",
    "fix:qcm-encoding": "python scripts/fix-qcm-utf8.py",
    "validate:qcm": "node scripts/validate-qcm-bank.mjs",
    "accent:duel-qcm": "node scripts/apply-duel-accents.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "firebase": "^12.11.0",
    "jspdf": "^4.2.1",
    "lottie-react": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^6.3.6"
  }
}
