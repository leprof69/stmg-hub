rules_version = '2';
// Sécurité progressive : évolution recommandée = champs jeu (xp, badges, etc.) mis à jour
// uniquement via Cloud Functions ou sous-collections avec règles strictes, et exposition
// classement via documents dérivés peu sensibles plutôt que lecture globale users.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function callerDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && callerDocExists() && callerProfile().role == "admin";
    }

    /** Un élève ne peut pas lui-même lever une suspension jetons (platformIntegrity). Seul un admin peut repasser xpSuspended à false. */
    function ownerDoesNotClearXpSuspension() {
      let beforeSus = resource.data.keys().hasAny(['platformIntegrity'])
        && resource.data.platformIntegrity.keys().hasAny(['xpSuspended'])
        && resource.data.platformIntegrity.xpSuspended == true;
      let afterSus = request.resource.data.keys().hasAny(['platformIntegrity'])
        && request.resource.data.platformIntegrity.keys().hasAny(['xpSuspended'])
        && request.resource.data.platformIntegrity.xpSuspended == true;
      return !beforeSus || afterSus;
    }

    function onboardingRoleAllowed() {
      return !request.resource.data.keys().hasAny(["role"])
        || request.resource.data.role in ["free", "eleve"];
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && onboardingRoleAllowed();

      allow read: if isSignedIn() && (
        isOwner(userId)
        || isAdmin()
        || resource.data.role != "admin"
      );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]))
          && ownerDoesNotClearXpSuspension()
        );

      allow delete: if isAdmin();
    }

    match /chapitres/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /missions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /** DS SDGN Premiere : cloture globale (couper sessions + bloquer lancement). */
    match /examConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /** Copie DS lisible par l'admin (miroir de users.dsTab a chaque fin de session). */
    match /dsSdgnResults/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin();
    }

    /** Notes DS /20 (document minimal — source admin prioritaire). */
    match /dsSdgnNotes/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin();
    }

    match /badges/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /** Duels asynchrones : un run = fantome (QCM fige + score / temps de l'auteur).
     *  Doit rester aligne avec src/data/duelQcmBank.ts : DUEL_QUESTIONS_PAR_PARTIE (8) et DUEL_TEMPS_TOTAL_SEC (72). */
    match /duelRuns/{runId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorPrenom is string
        && request.resource.data.authorPrenom.size() > 0
        && request.resource.data.authorPrenom.size() <= 48
        && request.resource.data.seasonId is string
        && request.resource.data.durationLimitSec is int
        && request.resource.data.durationLimitSec == 72
        && request.resource.data.questions is list
        && request.resource.data.questions.size() == 8
        && request.resource.data.ghostCorrect is int
        && request.resource.data.ghostCorrect >= 0
        && request.resource.data.ghostCorrect <= 8
        && request.resource.data.ghostTimeMs is int
        && request.resource.data.ghostTimeMs >= 1
        && request.resource.data.ghostTimeMs <= 300000;
      allow update, delete: if false;
    }

    match /duelAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/duelAttempts/$(attemptId))
        && request.resource.data.playerUid == request.auth.uid
        && request.resource.data.playerPrenom is string
        && request.resource.data.playerPrenom.size() > 0
        && request.resource.data.playerPrenom.size() <= 48
        && request.resource.data.runId is string
        && request.resource.data.seasonId is string
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 8
        && request.resource.data.timeMs is int
        && request.resource.data.timeMs >= 1
        && request.resource.data.timeMs <= 300000
        && exists(/databases/$(database)/documents/duelRuns/$(request.resource.data.runId))
        && get(/databases/$(database)/documents/duelRuns/$(request.resource.data.runId)).data.authorUid != request.auth.uid
        && get(/databases/$(database)/documents/duelRuns/$(request.resource.data.runId)).data.seasonId == request.resource.data.seasonId;
      allow update, delete: if false;
    }
  }
}
